# Copy this file to .env and fill in your own values.
# NEVER commit .env or paste real credentials into this repository.

# Gemini API key (Google AI Studio / Google Cloud).
GOOGLE_API_KEY=your_gemini_api_key_here

# Google Identity Services OAuth client ID (Web application client).
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id_here

# PostgreSQL connection string.
# Local Docker Compose uses the "db" hostname:
DATABASE_URL=postgresql://sta_ai:sta_ai@db:5432/sta_ai
# If you run uvicorn directly on the host with the Compose database, use:
# DATABASE_URL=postgresql://sta_ai:sta_ai@localhost:5432/sta_ai
# On Vercel use an external/managed PostgreSQL URL (never the Docker "db" host):
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Keep "true" in production (HTTPS). Set to "false" only for local HTTP testing.
# The app forces this to true whenever it detects the Vercel runtime.
COOKIE_SECURE=true

# Optional: comma-separated hostnames allowed to serve the app.
# Leave unset for local development. On Vercel, set this to the exact host(s)
# you serve. Vercel-generated domains use hyphens (e.g. sta-ai.vercel.app);
# add any custom domain you own as well. Previews are allowed automatically
# when this is unset (the deployment's VERCEL_URL is used).
# TRUSTED_HOSTS=sta-ai.vercel.app,localhost
# TRUSTED_HOSTS=sta-ai.vercel.app,sta_ai.vercel.com
